# ==========================================
# SKILL//X Backend Configuration
# ==========================================

# Application Settings
PROJECT_NAME="SKILL//X API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL / SQLite fallback for local dev if Postgres is not running)
# PostgreSQL format: postgresql://username:password@localhost:5432/skillx_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillx_db"

# Emergence Index Weights (Sum = 1.0)
WEIGHT_GROWTH=0.35
WEIGHT_ACCELERATION=0.25
WEIGHT_CROSS_INDUSTRY=0.20
WEIGHT_CO_OCCURRENCE=0.10
WEIGHT_MODEL_PREDICTION=0.10
